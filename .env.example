# Copy to .env for local runs. Docker Compose reads these too.
PORT=3000
NODE_ENV=development

# Where SQLite and uploaded files live. In Docker this is /data (a volume).
DATA_DIR=./data
DB_PATH=./data/clearpath.db

# Set to 1 behind HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=0

# Seed demo tenants, users and records on first boot (fresh database only).
SEED_DEMO=1

# Optional override for the landing-page contact address.
SUPPORT_EMAIL=hello@denovocredit.com
