# Clearpath — environment template.
#
# Copy to .env and fill in the values. Never commit .env; it is gitignored.
# Production secrets live in Cerulean Vault (KV v2) and are referenced as
# vault://<mount>/<path>#<KEY> by the stack that resolves them.
#
# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are
# Cerulean and NPM Edge. This repo does not implement any of the three.

# HTTP port
PORT=3000

# Public origin used in links and cookies
APP_ORIGIN=http://localhost:3000

# Database and upload directory
DATA_DIR=./data

# SQLite database file
DB_PATH=./data/clearpath.db

# Set to 1 behind HTTPS
COOKIE_SECURE=0

# Cerulean Authentik application issuer
AUTHENTIK_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/clearpath/

# Cerulean OIDC client id
AUTHENTIK_CLIENT_ID=clearpath

# Cerulean OIDC client secret (Vault in production)
AUTHENTIK_CLIENT_SECRET=change-me

# First platform operator
PLATFORM_ADMIN_EMAIL=admin@example.com

# Operator password; replace before first boot
PLATFORM_ADMIN_PASSWORD=change-me

# smtp or empty for the console transport
MAIL_TRANSPORT=

# From address
MAIL_FROM=Clearpath <no-reply@example.com>

# Lob key for certified mail; leave empty to disable
LOB_API_KEY=

# Lob webhook signing secret
LOB_WEBHOOK_SECRET=

# Optional drafting endpoint
OMNIROUTE_BASE_URL=https://gateway.innotel.us/v1

# Optional drafting key
OMNIROUTE_API_KEY=
