# Copy to .env. The app reads this file on start (real environment variables win),
# and Docker Compose also uses it for ${VAR} interpolation.

PORT=3000
NODE_ENV=development

# Where SQLite and uploaded files live. In Docker this is /data (a volume).
DATA_DIR=./data
DB_PATH=./data/clearpath.db

# 1 behind HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=0

# Seed demo tenants, users and records on first boot (fresh database only).
SEED_DEMO=1

# Absolute base URL used in emailed links. Required in production: without it
# links fall back to the tenant's own domain, or localhost.
APP_ORIGIN=http://localhost:3000

# Fallback contact address on the landing page.
SUPPORT_EMAIL=hello@denovocredit.com

# ---- Outbound email (invitations, password resets) -------------------------
# An agency owner can also set the SMTP server in Settings → Email server; that
# per-workspace row wins over the environment below. Values here are the
# deployment fallback (and the only option for the platform console's own mail).
# Leave everything unset to keep messages in the workspace Mail log instead of
# delivering them. Set ONE provider — an SMTP submission server (Stalwart,
# Postfix, Mailcow, …) or one of the HTTPS APIs.

# Stalwart / any SMTP submission server. 465 = implicit TLS (SMTP_SECURE=1),
# 587 = STARTTLS (the default). Use a dedicated mailbox and an application
# password rather than an administrator login.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=clearpath@example.com
# SMTP_PASS=
# Only for a trusted local relay without TLS: credentials cross the wire in the clear.
# SMTP_STARTTLS=0

# HTTPS APIs
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=
# POSTMARK_TOKEN=
# SENDGRID_API_KEY=

# Must be an address the provider authorises — for SMTP, the account itself or
# one of its addresses, because Stalwart's mustMatchSender defaults to on.
MAIL_FROM=Clearpath <no-reply@denovocredit.com>

# Key that seals a workspace's SMTP password before it goes into SQLite. When
# unset the app generates /data/mail.secret (mode 600); either way, back up the
# data directory, not just clearpath.db, or saved passwords cannot be read back.
# MAIL_SECRET=
# MAIL_REPLY_TO=support@denovocredit.com

# ---- Platform console ------------------------------------------------------
# The operator account that sits above the tenants. Created on boot when both
# email and password are set; otherwise a demo operator is seeded while
# SEED_DEMO is on (platform@clearpath.test / Platform!2026).
# PLATFORM_ADMIN_EMAIL
# PLATFORM_ADMIN_PASSWORD
# PLATFORM_ADMIN_NAME

# ---- AI gateway (OmniRoute) -----------------------------------------------
# OmniRoute is the only AI gateway this app talks to, and the API key is the
# only required setting. Without it every AI surface stays hidden and the
# deterministic drafter, pipeline and automation keep working.
# OMNIROUTE_API_KEY
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=auto

# ---- Print and mail (Lob) -------------------------------------------------
# Certified letters can be printed and posted through Lob. Leave the key unset
# and the mailroom keeps its print-and-post workflow; every Lob surface hides.
# LOB_API_KEY
# LOB_WEBHOOK_SECRET
# LOB_BASE_URL=https://api.lob.com/v1

# ---- Payments (Stripe) ----------------------------------------------------
# Subscription billing. A key set in the platform console (Payments) wins over
# these; use the variables when you would rather not store keys in the database.
# LOB-style prefixes: sk_test_… never charges, sk_live_… bills real cards.
# STRIPE_SECRET_KEY
# The endpoint's signing secret. Without it /webhooks/stripe refuses events and
# billing status stays frozen where Checkout left it.
# STRIPE_WEBHOOK_SECRET
# Only for tests or a Stripe-compatible mock.
# STRIPE_BASE_URL=https://api.stripe.com/v1
