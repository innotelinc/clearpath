<%- include("../partials/platform-head", { title }) %>

<div class="page-head">
  <div>
    <h1>Workspaces</h1>
    <p>Every agency on this deployment, with what it actually uses. Open one to see its team and client roster.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-primary" href="/platform/tenants/new"><svg><use href="#i-plus"/></svg>Provision workspace</a>
  </div>
</div>

<div class="kpis">
  <div class="card kpi">
    <div class="kpi-label">Workspaces</div>
    <div class="kpi-value"><%= totals.tenants %></div>
    <div class="kpi-meta"><%= totals.active %> active · <%= totals.suspended %> suspended</div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Clients</div>
    <div class="kpi-value"><%= totals.clients %></div>
    <div class="kpi-meta">Across every tenant</div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Staff seats</div>
    <div class="kpi-value"><%= totals.seats %></div>
    <div class="kpi-meta">Owners and specialists</div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Open disputes</div>
    <div class="kpi-value"><%= totals.openDisputes %></div>
    <div class="kpi-meta"><%= totals.documents %> documents on file</div>
  </div>
</div>

<section class="card" style="margin-top:20px">
  <div class="card-head">
    <div><h2>Tenant list</h2><p>Usage is counted live from each workspace's own records</p></div>
    <span class="chip mono"><%= totals.tenants %> total</span>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Workspace</th>
          <th>Status</th>
          <th>Plan</th>
          <th class="right">Clients</th>
          <th class="right">Seats</th>
          <th class="right">Open disputes</th>
          <th class="right">Documents</th>
          <th>Last activity</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% tenants.forEach((tenant) => { %>
          <tr>
            <td>
              <div class="who">
                <span class="avatar"><%= initials(tenant.name) %></span>
                <div>
                  <div><a class="link" href="/platform/tenants/<%= tenant.id %>"><%= tenant.name %></a></div>
                  <div class="tiny muted mono"><%= tenant.slug %><%= tenant.domain ? ` · ${tenant.domain}` : "" %></div>
                </div>
              </div>
            </td>
            <td>
              <% if (tenant.status === "suspended") { %>
                <span class="badge rose">Suspended</span>
              <% } else { %>
                <span class="badge teal">Active</span>
              <% } %>
            </td>
            <td>
              <% if (tenant.billing && tenant.billing.plan) { %>
                <span class="badge <%= tenant.billing.statusTone %> no-dot"><%= tenant.billing.plan.name %></span>
                <div class="tiny muted"><%= tenant.billing.statusLabel %><%= tenant.billing.renewsAt ? ` · ${fmtDate(tenant.billing.renewsAt)}` : "" %></div>
              <% } else { %>
                <span class="badge gray no-dot">No plan</span>
              <% } %>
            </td>
            <td class="right num"><%= tenant.usage.clients %></td>
            <td class="right num"><%= tenant.usage.seats %></td>
            <td class="right num"><%= tenant.usage.openDisputes %></td>
            <td class="right num"><%= tenant.usage.documents %></td>
            <td class="tiny muted"><%= tenant.usage.lastActivity ? fmtDateTime(tenant.usage.lastActivity) : "No activity yet" %></td>
            <td class="actions"><a class="btn btn-sm" href="/platform/tenants/<%= tenant.id %>">Open</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (!tenants.length) { %>
    <div class="card-body empty">
      <p class="muted">No workspaces yet. Provision the first one to create its owner account.</p>
    </div>
  <% } %>
</section>

<%# The clean-install button. It lives at the bottom of the roster because it is
    about the whole deployment, not one workspace, and it is the last thing an
    operator should reach for. What survives is stated here as plainly as what goes. %>
<section class="card" style="margin-top:20px">
  <div class="card-head">
    <div><h2>Reset system</h2><p>Return this deployment to a clean install</p></div>
    <span class="badge rose">Irreversible</span>
  </div>
  <div class="card-body stack">
    <p class="tiny muted" style="margin:0">
      Removes <strong><%= totals.tenants %></strong> workspace<%= totals.tenants === 1 ? "" : "s" %>,
      <strong><%= totals.clients %></strong> client<%= totals.clients === 1 ? "" : "s" %> and every record under them — seats,
      disputes, letters, documents (including the uploaded files), messages and the audit trail — so the next workspace
      you provision is id 1 on an empty database.
    </p>
    <p class="tiny muted" style="margin:0">
      <strong>Kept:</strong> your operator account and session, so you are still signed in when it finishes, and the
      payment settings, so billing does not silently turn off. Prospect leads from the marketing form are removed too.
    </p>
    <form class="row" method="post" action="/platform/reset" style="gap:8px;align-items:flex-end"
          data-confirm="Reset this entire deployment? Every workspace and client is removed. This cannot be undone.">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field" style="margin:0">
        <label for="reset-confirm">Type <span class="mono">RESET</span> to confirm</label>
        <input class="input" id="reset-confirm" name="confirm" required autocomplete="off" spellcheck="false" placeholder="RESET">
      </div>
      <button class="btn btn-danger" type="submit" data-busy-label="Resetting…">Reset to a clean install</button>
    </form>
  </div>
</section>

<%- include("../partials/platform-foot") %>
