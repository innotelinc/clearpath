<%- include("../partials/platform-head", { title }) %>

<div class="page-head">
  <div>
    <h1>Demo sign-ins</h1>
    <p>Every account in this database, with the seed password that verifies against its stored hash.</p>
  </div>
  <div class="page-actions">
    <span class="badge amber">Demo mode</span>
  </div>
</div>

<div class="notice notice-info" role="status">
  <svg><use href="#i-shield"/></svg>
  <div class="grow">
    These are the demonstration accounts this deployment seeded. Turn demo mode off
    (<span class="mono">SEED_DEMO=0</span>) before it holds real client data — this page and the
    cards on the sign-in screen disappear with it.
  </div>
</div>

<% report.workspaces.forEach((workspace) => { %>
  <section class="card" style="margin-top:20px">
    <div class="card-head">
      <div>
        <h2><%= workspace.name %></h2>
        <p>
          <span class="mono"><%= workspace.slug %></span>
          <%= workspace.domain ? ` · ${workspace.domain}` : "" %>
          <% if (workspace.status !== "active") { %> · <span class="badge rose no-dot"><%= workspace.status %></span><% } %>
        </p>
      </div>
      <span class="chip mono"><%= workspace.seats.length %> account<%= workspace.seats.length === 1 ? "" : "s" %></span>
    </div>

    <div class="card-body">
      <% if (workspace.site) { %>
        <div class="kv">
          <div><span class="k">Site</span><span class="v mono"><a href="<%= workspace.site %>" target="_blank" rel="noopener"><%= workspace.site %></a></span></div>
          <div><span class="k">Agency sign-in</span><span class="v mono"><a href="<%= workspace.agencyUrl %>" target="_blank" rel="noopener"><%= workspace.agencyUrl %></a></span></div>
          <div><span class="k">Client portal</span><span class="v mono"><a href="<%= workspace.portalUrl %>" target="_blank" rel="noopener"><%= workspace.portalUrl %></a></span></div>
          <% if (workspace.defaultOrigin) { %>
            <div><span class="k">Default host</span><span class="v mono"><%= workspace.defaultOrigin %> <span class="tiny muted">· served when the host matches no domain</span></span></div>
          <% } %>
        </div>
      <% } else { %>
        <p class="tiny muted">No domain is set, so this workspace has no URL of its own. Add one in Settings.</p>
      <% } %>
    </div>

    <% if (workspace.seats.length > 0) { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Role</th>
              <th>Name</th>
              <th>Email</th>
              <th>Password</th>
              <th class="right">Sign in</th>
            </tr>
          </thead>
          <tbody>
            <% workspace.seats.forEach((seat) => { %>
              <tr>
                <td>
                  <span class="badge <%= seat.role === "owner" ? "blue" : seat.role === "specialist" ? "teal" : "gray" %> no-dot">
                    <%= seat.role %>
                  </span>
                </td>
                <td>
                  <%= seat.name %>
                  <% if (seat.clientRef) { %><span class="tiny muted mono">· <%= seat.clientRef %></span><% } %>
                </td>
                <td class="mono tiny"><%= seat.email %></td>
                <td>
                  <% if (seat.password) { %>
                    <span class="chip mono"><%= seat.password %></span>
                    <button class="btn btn-sm" type="button" data-copy="<%= seat.password %>">Copy</button>
                  <% } else { %>
                    <span class="tiny muted">changed since the seed</span>
                  <% } %>
                </td>
                <td class="right">
                  <% if (seat.signIn) { %>
                    <a class="btn btn-sm" href="<%= seat.signIn %>" target="_blank" rel="noopener">
                      <%= seat.role === "client" ? "Portal" : "Console" %>
                    </a>
                  <% } else { %>—<% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
<% }) %>

<% if (report.operators.length > 0) { %>
  <section class="card" style="margin-top:20px">
    <div class="card-head">
      <div>
        <h2>Platform console</h2>
        <p>Above the tenants — not a workspace account</p>
      </div>
      <a class="btn btn-sm" href="<%= report.platformUrl %>" target="_blank" rel="noopener">Open console</a>
    </div>
    <div class="card-body">
      <div class="kv">
        <div><span class="k">Sign-in</span><span class="v mono"><%= report.platformUrl %></span></div>
      </div>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Name</th><th>Email</th><th>Password</th></tr>
        </thead>
        <tbody>
          <% report.operators.forEach((operator) => { %>
            <tr>
              <td><%= operator.name %></td>
              <td class="mono tiny"><%= operator.email %></td>
              <td>
                <% if (operator.password) { %>
                  <span class="chip mono"><%= operator.password %></span>
                  <button class="btn btn-sm" type="button" data-copy="<%= operator.password %>">Copy</button>
                <% } else { %>
                  <span class="tiny muted">changed since the seed</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<% if (report.changed > 0) { %>
  <div class="notice notice-info" style="margin-top:20px" role="status">
    <svg><use href="#i-alert"/></svg>
    <div class="grow">
      <strong><%= report.changed %> account<%= report.changed === 1 ? "" : "s" %> no longer use a demo password.</strong>
      Reset a password from the workspace's Settings → Team, or rebuild the demonstration install with
      <span class="mono">npm run reseed -- --confirm RESEED</span>.
    </div>
  </div>
<% } %>

<p class="tiny muted" style="margin-top:16px">
  The same report is available from a shell as <span class="mono">npm run credentials</span>, and
  <span class="mono">npm run credentials -- --site</span> prints only the workspace URLs.
</p>

<%- include("../partials/platform-foot") %>
