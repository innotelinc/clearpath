<%- include("../partials/app-head", { title }) %>

<div class="page-head">
  <div class="detail-title">
    <span class="avatar lg"><%= initials(clientRecord ? clientRecord.name : "Package") %></span>
    <div>
      <h1><%= pkg.ref %></h1>
      <div class="meta">
        <%= clientRecord ? clientRecord.name : "Client removed" %> ·
        <%= bureau[pkg.bureau] ? bureau[pkg.bureau].name : pkg.bureau %> ·
        <%= pkg.letters %> letter<%= pkg.letters === 1 ? "" : "s" %>
      </div>
      <div class="row" style="margin-top:8px">
        <span class="badge <%= statusClass(pkg.status) %>"><%= pkg.status %></span>
        <span class="badge gray no-dot"><%= pkg.method %></span>
        <span class="badge blue no-dot"><%= money(pkg.cost) %></span>
      </div>
    </div>
  </div>
  <div class="page-actions">
    <a class="btn" href="/app/mailroom">Mailroom</a>
    <% if (pkg.status === "Ready") { %>
      <% if (lobConfigured) { %>
        <form method="post" action="/app/mailroom/<%= pkg.id %>/send" data-confirm="Send <%= pkg.letters %> certified letter<%= pkg.letters === 1 ? '' : 's' %> through Lob? This spends real postage<%= lobMode === 'test' ? ' in test mode (no real mail)' : '' %>.">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-primary" type="submit" data-busy-label="Sending…">
            <svg><use href="#i-send"/></svg>Send via Lob<%= lobMode === 'test' ? ' (test)' : '' %>
          </button>
        </form>
      <% } %>
      <form method="post" action="/app/mailroom/<%= pkg.id %>/mailed" data-confirm="Mark <%= pkg.ref %> mailed by hand? The letter text is stored on the package and the 30-day clock starts.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="tracking" value="<%= pkg.tracking || "" %>">
        <button class="btn" type="submit">Mark mailed by hand</button>
      </form>
    <% } %>
  </div>
</div>

<div class="kpis">
  <div class="card kpi">
    <div class="kpi-label">Tracking</div>
    <div class="kpi-value" style="font-size:18px">
      <% if (pkg.tracking) { %>
        <a href="<%= trackingUrl(pkg.tracking) %>" target="_blank" rel="noopener"><span class="mono"><%= pkg.tracking %></span></a>
      <% } else { %>
        <span class="muted">Not recorded</span>
      <% } %>
    </div>
    <div class="kpi-meta">
      <% if (pkg.tracking) { %>
        <a href="<%= trackingUrl(pkg.tracking) %>" target="_blank" rel="noopener">Open carrier tracking ↗</a>
      <% } else { %>
        Add it when you mark the package mailed.
      <% } %>
    </div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Sent</div>
    <div class="kpi-value" style="font-size:18px"><%= pkg.sent_at ? fmtDate(pkg.sent_at) : pkg.status === "Ready" ? "Not yet" : "Before this build" %></div>
    <div class="kpi-meta"><%= pkg.sent_at ? "Recorded at mailing" : pkg.status === "Ready" ? "Waiting to be posted" : "Sent before the archive existed" %></div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Letters</div>
    <div class="kpi-value"><%= letters.length %></div>
    <div class="kpi-meta"><%= snapshot ? "Stored as sent" : "Live dispute text" %></div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Postage</div>
    <div class="kpi-value"><%= money(pkg.cost) %></div>
    <div class="kpi-meta"><%= pkg.method %></div>
  </div>
</div>

<% if (dispatches.length) { %>
  <section class="card" style="margin-top:20px">
    <div class="card-head">
      <div>
        <h2>Dispatch</h2>
        <p>Handed to Lob for printing and certified postage</p>
      </div>
      <span class="badge <%= lobMode === 'live' ? 'teal' : 'gray' %> no-dot"><%= lobMode === 'live' ? 'Lob live' : 'Lob test' %></span>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Letter</th><th>Lob id</th><th>Tracking</th><th>Expected</th><th>Status</th></tr></thead>
        <tbody>
          <% dispatches.forEach((dispatch) => { %>
            <tr>
              <td class="mono">#<%= dispatch.dispute_id %></td>
              <td class="mono tiny"><%= dispatch.provider_letter_id %></td>
              <td class="small">
                <% if (dispatch.tracking) { %>
                  <a class="mono" href="<%= trackingUrl(dispatch.tracking) %>" target="_blank" rel="noopener"><%= dispatch.tracking %></a>
                <% } else { %>
                  <span class="muted">Assigned by USPS after printing</span>
                <% } %>
              </td>
              <td class="tiny muted"><%= dispatch.expected_delivery ? fmtDate(dispatch.expected_delivery) : "—" %></td>
              <td><span class="badge <%= statusClass(dispatch.status) %> no-dot"><%= dispatch.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (events.length) { %>
      <div class="card-body" style="border-top:1px solid var(--line)">
        <h3 class="tiny" style="text-transform:uppercase;letter-spacing:.08em;color:var(--ink-4);margin:0 0 8px">Delivery events</h3>
        <div class="feed">
          <% events.forEach((event) => { %>
            <div class="feed-row">
              <span class="feed-dot" style="background:var(--teal)"></span>
              <div class="body">
                <strong><%= event.event %></strong><br>
                <%= event.detail || "No detail from the carrier." %>
                <time><%= fmtDateTime(event.occurred_at) %></time>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </section>
<% } %>

<section class="card" style="margin-top:20px">
  <div class="card-head">
    <div>
      <h2>What was sent</h2>
      <p><%= snapshot ? "Frozen at the moment the package was marked mailed" : "Taken from the live disputes — this package predates the snapshot" %></p>
    </div>
    <span class="chip mono"><%= letters.length %> letter<%= letters.length === 1 ? "" : "s" %></span>
  </div>
  <% if (!letters.length) { %>
    <div class="card-body empty">
      <p class="muted">No letters are attached to this package.</p>
    </div>
  <% } else { %>
    <div class="card-body stack" style="gap:14px">
      <% letters.forEach((letter) => { %>
        <details class="card" style="box-shadow:none">
          <summary style="cursor:pointer;padding:14px 16px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
            <span class="mono"><%= letter.ref %></span>
            <strong><%= letter.account %></strong>
            <span class="badge blue no-dot"><%= bureau[letter.bureau] ? bureau[letter.bureau].short : letter.bureau %></span>
            <span class="grow"></span>
            <% if (letter.captured_at) { %>
              <span class="tiny muted">stored <%= fmtDateTime(letter.captured_at) %></span>
            <% } %>
          </summary>
          <div class="card-body" style="border-top:1px solid var(--line)">
            <% if (String(letter.body || "").trim()) { %>
              <pre class="doc-body" style="white-space:pre-wrap;margin:0"><%= letter.body %></pre>
              <% if (letter.live) { %>
                <p class="tiny muted" style="margin:12px 0 0">
                  The dispute's current text. This package was posted before its letters were stored,
                  so no copy of the printed page survived — this is the closest record left, and it
                  may differ from what was mailed.
                </p>
              <% } %>
            <% } else { %>
              <p class="tiny muted" style="margin:0">
                Nothing is left to show for this letter: it was recorded before letter bodies were
                stored, and the dispute it names is no longer in this workspace.
              </p>
            <% } %>
            <% if (letter.dispute_id) { %>
              <div class="form-actions" style="margin-top:12px">
                <a class="btn btn-sm" href="/app/disputes/<%= letter.dispute_id %>">Open dispute</a>
              </div>
            <% } %>
          </div>
        </details>
      <% }) %>
    </div>
  <% } %>
  <% if (!lobConfigured) { %>
    <div class="card-foot">
      <p class="tiny muted" style="margin:0">
        Set <code>LOB_API_KEY</code> to print and post packages through Lob, with certified tracking and delivery events.
        Until then, print the packet and mark it mailed by hand.
      </p>
    </div>
  <% } %>
</section>

<%- include("../partials/app-foot") %>
