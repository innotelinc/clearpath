<%- include("../partials/app-head", { title }) %>

<div class="page-head">
  <div class="detail-title">
    <span class="avatar lg"><%= initials(clientRecord ? clientRecord.name : "Package") %></span>
    <div>
      <h1><%= pkg.ref %></h1>
      <div class="meta">
        <%= clientRecord ? clientRecord.name : "Client removed" %> ·
        <%= bureau[pkg.bureau] ? bureau[pkg.bureau].name : pkg.bureau %> ·
        <%= pkg.letters %> letter<%= pkg.letters === 1 ? "" : "s" %>
      </div>
      <div class="row" style="margin-top:8px">
        <span class="badge <%= statusClass(pkg.status) %>"><%= pkg.status %></span>
        <span class="badge gray no-dot"><%= pkg.method %></span>
        <span class="badge blue no-dot"><%= money(pkg.cost) %></span>
      </div>
    </div>
  </div>
  <div class="page-actions">
    <a class="btn" href="/app/mailroom">Mailroom</a>
    <% if (pkg.status === "Ready") { %>
      <form method="post" action="/app/mailroom/<%= pkg.id %>/mailed" data-confirm="Mark <%= pkg.ref %> mailed? The letter text is stored on the package and the 30-day clock starts.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="tracking" value="<%= pkg.tracking || "" %>">
        <button class="btn btn-primary" type="submit">Mark mailed</button>
      </form>
    <% } %>
  </div>
</div>

<div class="kpis">
  <div class="card kpi">
    <div class="kpi-label">Tracking</div>
    <div class="kpi-value" style="font-size:18px">
      <% if (pkg.tracking) { %>
        <a href="<%= trackingUrl(pkg.tracking) %>" target="_blank" rel="noopener"><span class="mono"><%= pkg.tracking %></span></a>
      <% } else { %>
        <span class="muted">Not recorded</span>
      <% } %>
    </div>
    <div class="kpi-meta">
      <% if (pkg.tracking) { %>
        <a href="<%= trackingUrl(pkg.tracking) %>" target="_blank" rel="noopener">Open carrier tracking ↗</a>
      <% } else { %>
        Add it when you mark the package mailed.
      <% } %>
    </div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Sent</div>
    <div class="kpi-value" style="font-size:18px"><%= pkg.sent_at ? fmtDate(pkg.sent_at) : pkg.status === "Ready" ? "Not yet" : "Before this build" %></div>
    <div class="kpi-meta"><%= pkg.sent_at ? "Recorded at mailing" : pkg.status === "Ready" ? "Waiting to be posted" : "Sent before the archive existed" %></div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Letters</div>
    <div class="kpi-value"><%= letters.length %></div>
    <div class="kpi-meta"><%= snapshot ? "Stored as sent" : "Live dispute text" %></div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Postage</div>
    <div class="kpi-value"><%= money(pkg.cost) %></div>
    <div class="kpi-meta"><%= pkg.method %></div>
  </div>
</div>

<section class="card" style="margin-top:20px">
  <div class="card-head">
    <div>
      <h2>What was sent</h2>
      <p><%= snapshot ? "Frozen at the moment the package was marked mailed" : "Taken from the live disputes — this package predates the snapshot" %></p>
    </div>
    <span class="chip mono"><%= letters.length %> letter<%= letters.length === 1 ? "" : "s" %></span>
  </div>
  <% if (!letters.length) { %>
    <div class="card-body empty">
      <p class="muted">No letters are attached to this package.</p>
    </div>
  <% } else { %>
    <div class="card-body stack" style="gap:14px">
      <% letters.forEach((letter) => { %>
        <details class="card" style="box-shadow:none">
          <summary style="cursor:pointer;padding:14px 16px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
            <span class="mono"><%= letter.ref %></span>
            <strong><%= letter.account %></strong>
            <span class="badge blue no-dot"><%= bureau[letter.bureau] ? bureau[letter.bureau].short : letter.bureau %></span>
            <span class="grow"></span>
            <% if (letter.captured_at) { %>
              <span class="tiny muted">stored <%= fmtDateTime(letter.captured_at) %></span>
            <% } %>
          </summary>
          <div class="card-body" style="border-top:1px solid var(--line)">
            <% if (String(letter.body || "").trim()) { %>
              <pre class="doc-body" style="white-space:pre-wrap;margin:0"><%= letter.body %></pre>
            <% } else { %>
              <p class="tiny muted" style="margin:0">
                This letter was recorded before letter bodies were stored, so only the dispute reference survives.
                Open the dispute for its current text.
              </p>
            <% } %>
            <% if (letter.dispute_id) { %>
              <div class="form-actions" style="margin-top:12px">
                <a class="btn btn-sm" href="/app/disputes/<%= letter.dispute_id %>">Open dispute</a>
              </div>
            <% } %>
          </div>
        </details>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include("../partials/app-foot") %>
