<%- include("../partials/app-head", { title }) %>

<%
  const pending = documents.filter((d) => d.status === "Pending review").length;
  const verified = documents.filter((d) => d.status === "Verified").length;
  const openRequests = requests.filter((r) => !r.done);
%>

<div class="page-head">
  <div>
    <h1>Documents</h1>
    <p><%= documents.length %> files · <%= verified %> verified · <%= pending %> awaiting review</p>
  </div>
  <div class="page-actions">
    <button class="btn" type="button" data-open="request-doc">Request from client</button>
    <button class="btn btn-primary" type="button" data-open="upload-doc"><svg><use href="#i-upload"/></svg> Upload</button>
  </div>
</div>

<div class="card card-pad">
  <form class="filters" method="get" action="/app/documents" role="search">
    <input class="input grow" type="search" name="q" value="<%= q %>" placeholder="Search document or client" aria-label="Search documents">
    <select class="select" name="type" aria-label="Filter by type" data-auto-filter>
      <option value="">All types</option>
      <% ["Identity", "Evidence", "Bureau response", "Agreement"].forEach((t) => { %>
        <option value="<%= t %>" <%= type === t ? "selected" : "" %>><%= t %></option>
      <% }) %>
    </select>
    <button class="btn" type="submit">Search</button>
    <% if (q || type) { %><a class="btn btn-ghost" href="/app/documents">Clear</a><% } %>
  </form>
</div>

<div class="dash-grid">
  <section class="card">
    <div class="card-head">
      <div><h2>Vault</h2><p>Every file is hashed at upload and scoped to one client</p></div>
    </div>
    <% if (!documents.length) { %>
      <div class="empty"><h3>No documents</h3><p>Upload an ID or a bureau response to start the vault.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Document</th><th>Client</th><th>Type</th><th>Status</th><th>SHA-256</th><th>Uploaded</th><th></th></tr></thead>
          <tbody>
            <% documents.forEach((doc) => { %>
              <tr>
                <td>
                  <div class="row" style="gap:9px">
                    <svg style="width:16px;height:16px;color:var(--ink-3)"><use href="#i-file"/></svg>
                    <div>
                      <a class="small" style="font-weight:570" href="/app/documents/<%= doc.id %>"><%= doc.name %></a>
                      <div class="tiny muted"><%= doc.ref %> · <%= doc.size || "—" %></div>
                    </div>
                  </div>
                </td>
                <td><a class="link small" href="/app/clients/<%= doc.client_id %>"><%= doc.client_name %></a></td>
                <td class="small"><%= doc.type %></td>
                <td><span class="badge <%= statusClass(doc.status) %>"><%= doc.status %></span></td>
                <td class="mono muted"><%= String(doc.sha256).slice(0, 10) %>…</td>
                <td class="nowrap small muted"><%= fmtDate(doc.uploaded_at) %><div class="tiny"><%= doc.uploaded_by %></div></td>
                <td class="actions">
                  <a class="btn btn-sm<%= doc.status === "Verified" ? " btn-ghost" : "" %>" href="/app/documents/<%= doc.id %>">
                    <%= doc.status === "Verified" ? "Open" : "Review" %>
                  </a>
                  <% if (doc.stored_name) { %>
                    <a class="btn btn-sm btn-ghost" href="/app/documents/<%= doc.id %>/download">Download</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="card">
    <div class="card-head">
      <div><h2>Open requests</h2><p>Live in the client portal</p></div>
      <span class="badge <%= openRequests.length ? "amber" : "teal" %>"><%= openRequests.length %></span>
    </div>
    <% if (!requests.length) { %>
      <div class="empty"><h3>No requests</h3><p>Ask a client for the document a dispute needs.</p></div>
    <% } else { %>
      <div class="list-rows">
        <% requests.forEach((r) => { %>
          <div class="list-row">
            <% if (r.done) { %>
              <svg style="width:16px;height:16px;color:var(--teal)"><use href="#i-check"/></svg>
            <% } else { %>
              <svg style="width:16px;height:16px;color:var(--amber)"><use href="#i-clock"/></svg>
            <% } %>
            <div class="grow">
              <div class="title"><%= r.label %></div>
              <div class="meta"><%= r.client_name %> · <%= r.type %><%= r.due ? ` · due ${r.due}` : "" %></div>
            </div>
            <span class="badge <%= r.done ? "teal" : "amber" %>"><%= r.done ? "Received" : "Open" %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<dialog class="modal" id="upload-doc" aria-labelledby="ud-title">
  <form method="post" action="/app/documents" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-head">
      <div>
        <h2 id="ud-title">Upload a document</h2>
        <p>PDF, PNG, JPEG or HEIC · 10 MB maximum</p>
      </div>
      <button class="icon-btn" type="button" data-close aria-label="Close"><svg><use href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="field">
        <label for="ud-client">Client</label>
        <select class="select" id="ud-client" name="client_id" required>
          <% clients.forEach((c) => { %>
            <option value="<%= c.id %>"><%= c.name %> · <%= c.ref %></option>
          <% }) %>
        </select>
      </div>
      <div class="dropzone">
        <svg style="width:22px;height:22px;color:var(--ink-3)"><use href="#i-upload"/></svg>
        <div style="margin-top:6px" id="ud-name">No file selected</div>
        <input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.heic,.heif" required data-file-input="#ud-name" aria-label="Document file">
      </div>
      <div class="field">
        <label for="ud-type">Type</label>
        <select class="select" id="ud-type" name="type">
          <option>Evidence</option><option>Identity</option><option>Bureau response</option><option>Agreement</option>
        </select>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" type="button" data-close>Cancel</button>
      <button class="btn btn-primary" type="submit">Upload &amp; hash</button>
    </div>
  </form>
</dialog>

<dialog class="modal" id="request-doc" aria-labelledby="rd-title">
  <form method="post" action="/app/documents/request">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-head">
      <div>
        <h2 id="rd-title">Request a document</h2>
        <p>The client sees it in their portal immediately.</p>
      </div>
      <button class="icon-btn" type="button" data-close aria-label="Close"><svg><use href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="field">
        <label for="rd-client">Client</label>
        <select class="select" id="rd-client" name="client_id" required>
          <% clients.forEach((c) => { %>
            <option value="<%= c.id %>"><%= c.name %> · <%= c.ref %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-grid">
        <div class="field span-2">
          <label for="rd-label">What do you need?</label>
          <input class="input" id="rd-label" name="label" required maxlength="80" placeholder="Proof of address — utility bill">
        </div>
        <div class="field">
          <label for="rd-type">Type</label>
          <select class="select" id="rd-type" name="type">
            <option>Identity</option><option>Evidence</option><option>Bureau response</option><option>Agreement</option>
          </select>
        </div>
        <div class="field">
          <label for="rd-due">Due</label>
          <input class="input" id="rd-due" name="due" maxlength="20" placeholder="Nov 4">
        </div>
        <div class="field span-2">
          <label for="rd-note">Note</label>
          <textarea class="textarea" id="rd-note" name="note" rows="2" maxlength="300" placeholder="A bill from the last 60 days."></textarea>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" type="button" data-close>Cancel</button>
      <button class="btn btn-primary" type="submit">Send request</button>
    </div>
  </form>
</dialog>

<%- include("../partials/app-foot") %>
