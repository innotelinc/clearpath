        <%= tenant && tenant.brand_name ? tenant.brand_name : "Denovo Credit" %> ·
        <a href="mailto:<%= tenant && tenant.support_email ? tenant.support_email : 'hello@denovocredit.com' %>"><%= tenant && tenant.support_email ? tenant.support_email : "hello@denovocredit.com" %></a>
        <%= tenant && tenant.support_phone ? ` · ${tenant.support_phone}` : "" %>
      </p>
      <p>Portal questions are answered by your specialist, usually within one business day.</p>
    </div>
  </footer>
  <script src="/assets/js/app.js" defer></script>
</body>
</html>
