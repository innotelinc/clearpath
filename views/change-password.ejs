<%
  const brand = tenant || hostTenant;
  const isClient = mode === "client";
  const siteName = brand ? brand.brand_name : "Denovo Credit";
  const forced = user && user.must_change_password;
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#0b1424">
  <style>:root{--accent:<%= brand && brand.accent ? brand.accent : '#1f5eff' %>;}</style>
  <link rel="stylesheet" href="<%= asset("css/app.css") %>">
  <link rel="icon" href="<%= asset("favicon.svg") %>" type="image/svg+xml">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <%- include("partials/icons") %>
  <div class="auth-page">
    <aside class="auth-aside">
      <a class="brand" href="/" style="color:#fff">
        <span class="brand-mark"><%= brand && brand.logo ? brand.logo : "DC" %></span>
        <span>
          <span class="brand-name"><%= siteName %></span>
          <span class="brand-sub" style="display:block;color:#8698b3">Clearpath platform</span>
        </span>
      </a>
      <div>
        <h2><%= forced ? "Pick a password of your own." : "Keep the account yours." %></h2>
        <p>
          <%= forced
            ? "The temporary password in your invitation email was meant for one sign-in. Choose something only you know before continuing."
            : "Changing your password signs out every other device on this account." %>
        </p>
      </div>
      <p class="foot">© <%= new Date().getFullYear() %> Denovo Credit · denovocredit.com</p>
    </aside>

    <main class="auth-main" id="main">
      <div class="auth-card">
        <a class="brand" href="/">
          <span class="brand-mark accent"><%= brand && brand.logo ? brand.logo : "DC" %></span>
          <span class="brand-name">Clearpath</span>
        </a>
        <h1><%= forced ? "Choose your password" : "Change your password" %></h1>
        <p>Signed in as <strong><%= user ? user.email : "" %></strong>.</p>

        <% if (error) { %>
          <div class="notice notice-error" style="margin-top:20px" role="alert">
            <svg><use href="#i-alert"/></svg>
            <div><%= error %></div>
          </div>
        <% } %>

        <form method="post" action="/change-password" autocomplete="off">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="after" value="<%= next %>">
          <% if (!forced) { %>
            <div class="field">
              <label for="current">Current password</label>
              <input class="input" id="current" name="current" type="password" autocomplete="current-password" required>
            </div>
          <% } %>
          <div class="field">
            <label for="next-password">New password</label>
            <input class="input" id="next-password" name="next" type="password" autocomplete="new-password"
                   minlength="10" required <%= forced ? "autofocus" : "" %>>
            <span class="hint">At least 10 characters, including a letter and a number.</span>
          </div>
          <div class="field">
            <label for="confirm">Repeat the new password</label>
            <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password"
                   minlength="10" required>
          </div>
          <button class="btn btn-primary btn-block btn-lg" type="submit" data-busy-label="Saving…">Save password</button>
        </form>

        <form method="post" action="/logout" style="margin-top:16px">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-ghost btn-block" type="submit">Sign out instead</button>
        </form>
      </div>
    </main>
  </div>
  <script src="<%= asset("js/app.js") %>" defer></script>
</body>
</html>
